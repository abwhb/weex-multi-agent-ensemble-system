{
  "name": "weex-multi-agent-alpha",
  "version": "0.1.0",
  "description": "Multi-Agent Ensemble AI Trading System for WEEX AI Wars Hackathon",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "backtest": "ts-node src/backtest/run-backtest.ts",
    "backtest:btc": "ts-node src/backtest/run-backtest.ts --symbol BTC --days 30 -v",
    "backtest:eth": "ts-node src/backtest/run-backtest.ts --symbol ETH --days 30 -v",
    "backtest:sol": "ts-node src/backtest/run-backtest.ts --symbol SOL --days 30 -v",
    "backtest:all": "npm run backtest:btc && npm run backtest:eth && npm run backtest:sol",
    "paper": "ts-node src/simulation/run-paper-trading.ts",
    "paper:fast": "ts-node src/simulation/run-paper-trading.ts --update 30",
    "dashboard": "ts-node src/simulation/live-dashboard.ts"
  },
  "keywords": [
    "ai",
    "trading",
    "weex",
    "multi-agent",
    "machine-learning",
    "crypto"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.0",
    "winston": "^3.11.0",
    "ws": "^8.14.0",
    "technicalindicators": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/parser": "^6.13.0"
  }
}